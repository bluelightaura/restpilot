"""Shared fixtures for the tests generated by RestPilot.

The base URL and the bearer token are read from the environment so that no
credential is ever written to this file:

    export RESTPILOT_BASE_URL="{{ base_url }}"
    export RESTPILOT_TOKEN="..."
"""

import os
from collections.abc import Iterator

import httpx
import pytest

BASE_URL = os.environ.get("RESTPILOT_BASE_URL", "{{ base_url }}")
TIMEOUT = float(os.environ.get("RESTPILOT_TIMEOUT", "10"))


def pytest_configure(config: pytest.Config) -> None:
    """Register the markers used by the generated tests."""
    config.addinivalue_line("markers", "api: generated API test")
    config.addinivalue_line("markers", "smoke: generated smoke test")


@pytest.fixture(scope="session")
def api_client() -> Iterator[httpx.Client]:
    """An HTTPX client pointed at the API under test."""
    headers = {"Accept": "application/json"}
    token = os.environ.get("RESTPILOT_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    with httpx.Client(base_url=BASE_URL, timeout=TIMEOUT, headers=headers) as client:
        yield client
